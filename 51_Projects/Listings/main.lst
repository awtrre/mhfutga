  13          long g_position_ms = 0;    /* Global motor position in ms */
  14          
  15          /**
  16           * @brief  Read the 32-bit saved position from EEPROM (0x2000..0x2003),
  17           *         combine into 'g_position_ms' (little-endian).
  18           */
  19          static void LoadPositionFromEEPROM(void)
  20          {
  21   1          unsigned char b0, b1, b2, b3;
  22   1          unsigned int base_addr = 0x2000;
  23   1      
  24   1          /* Read four bytes from EEPROM */
  25   1          b0 = EEPROM_ReadByte(base_addr);
  26   1          b1 = EEPROM_ReadByte(base_addr + 1);
  27   1          b2 = EEPROM_ReadByte(base_addr + 2);
  28   1          b3 = EEPROM_ReadByte(base_addr + 3);
  29   1      
  30   1          /* Combine into a signed 32-bit long (little-endian) */
  31   1          g_position_ms =  (long)b0
  32   1                         | ((long)b1 << 8)
  33   1                         | ((long)b2 << 16)
  34   1                         | ((long)b3 << 24);
  35   1      }
