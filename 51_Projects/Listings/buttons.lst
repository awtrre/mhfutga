  97          /**
  98           * @brief One-key OPEN button handler (P3.2).
  99           * If idle, call OneKey_Open(); if running, call OneKey_StopAndSave().
 100           */
 101          void Button3_Handle(void)
 102          {
 103   1          if (is_btn3()) {
