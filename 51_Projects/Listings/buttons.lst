  11          /* Debounce time in ms */
  12          #define DEBOUNCE_MS       50U
  13          
  14          /* Manual rotation slice in ms for Button1 and Button2 */
  15          #define MANUAL_STEP_MS   700U
  16          
  17          /* Internal helpers: active-low checks for buttons on P3 */
  18          static bit is_btn1(void)    { return (P3 & 0x01) == 0; }  /* P3.0 */
  19          static bit is_btn2(void)    { return (P3 & 0x02) == 0; }  /* P3.1 */
  20          static bit is_btn3(void)    { return (P3 & 0x04) == 0; }  /* P3.2 */
  21          static bit is_btn4(void)    { return (P3 & 0x08) == 0; }  /* P3.3 */
  22          
  23          /**
  24           * @brief Configure P3.0..P3.3 as inputs with internal pull-ups.
  25           */
  26          void Buttons_Init(void)
  27          {
  28   1          P3 = 0xFF;  /* Set P3 pins to high (inputs with pull-ups) */
  29   1      }
  30          
  31          /**
  32           * @brief Manual forward button handler (P3.0).
  33           * While held and not at max, run forward 700ms slices.
  34           */
  35          void Button1_Handle(void)
  36          {
  37   1          unsigned long slice;
  38   1      
  39   1          if (is_btn1()) {
  40   2              delay_ms(DEBOUNCE_MS);
  41   2              if (is_btn1()) {
  42   3                  /* If at or beyond fully open, do nothing */
  43   3                  if (g_position_ms >= TOTAL_TIME_MS) {
  44   4                      StepMotor_Stop();
  45   4                      delay_ms(DEBOUNCE_MS);
  46   4                      while (is_btn1());
  47   4                      return;
  48   4                  }
  49   3                  /* While pressed and not at max, run forward in slices */
  50   3                  while (is_btn1() && g_position_ms < TOTAL_TIME_MS) {
  51   4                      slice = (TOTAL_TIME_MS - g_position_ms >= MANUAL_STEP_MS)
  52   4                                  ? MANUAL_STEP_MS
  53   4                                  : (unsigned long)(TOTAL_TIME_MS - g_position_ms);
  54   4                      StepMotor_RunMs((unsigned int)slice);
