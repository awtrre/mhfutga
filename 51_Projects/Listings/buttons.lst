  64          /**
  65           * @brief Manual reverse button handler (P3.1).
  66           * While held and not at zero, run reverse 700ms slices.
  67           */
  68          void Button2_Handle(void)
  69          {
  70   1          unsigned long slice;
  71   1      
  72   1          if (is_btn2()) {
  73   2              delay_ms(DEBOUNCE_MS);
  74   2              if (is_btn2()) {
  75   3                  /* If already at zero, do nothing */
  76   3                  if (g_position_ms == 0) {
  77   4                      StepMotor_Stop();
  78   4                      delay_ms(DEBOUNCE_MS);
  79   4                      while (is_btn2());
  80   4                      return;
  81   4                  }
  82   3                  /* While pressed and not at zero, run reverse in slices */
  83   3                  while (is_btn2() && g_position_ms > 0) {
